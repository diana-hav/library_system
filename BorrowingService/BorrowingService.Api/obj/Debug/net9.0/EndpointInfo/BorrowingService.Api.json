{
  "openapi": "3.0.1",
  "info": {
    "title": "Borrowing Service API",
    "description": "API ��� ������ �� ���������� ���� � ��������",
    "contact": {
      "name": "Library System Team",
      "email": "support@library.local"
    },
    "version": "v1"
  },
  "paths": {
    "/api/Books": {
      "get": {
        "tags": [
          "Books"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Books/{id}": {
      "get": {
        "tags": [
          "Books"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Borrowings": {
      "get": {
        "tags": [
          "Borrowings"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Borrowings/issue": {
      "post": {
        "tags": [
          "Borrowings"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IssueBookRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/IssueBookRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/IssueBookRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Borrowings/return/{id}": {
      "put": {
        "tags": [
          "Borrowings"
